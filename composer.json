{
    "name": "phattarachai/task-runs-laravel",
    "description": "In-app background-task status tracking for Laravel — opt-in jobs record task_runs rows with live progress, cooperative cancel, overlap + orphan guards, and a broadcast/poll UI contract.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "queue",
        "horizon",
        "background-jobs",
        "progress",
        "task-tracking"
    ],
    "authors": [
        {
            "name": "Phattarachai Chaimongkol",
            "email": "pc@phattarachai.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/broadcasting": "^12.0 || ^13.0",
        "illuminate/bus": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/queue": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.8|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "suggest": {
        "laravel/horizon": "Surfaces worker health on the tasks screen (the package degrades to status 'unavailable' without it).",
        "inertiajs/inertia-laravel": "Required only for the optional bundled tasks page — the JSON contract works without it."
    },
    "autoload": {
        "psr-4": {
            "Phattarachai\\TaskRunsLaravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phattarachai\\TaskRunsLaravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Phattarachai\\TaskRunsLaravel\\TaskRunsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
